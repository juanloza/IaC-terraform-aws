# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory and plugins
.terraform/
.terraform.lock.hcl
# ...but do version the dependency lock file for root modules (environments) so
# provider versions are pinned for anyone deploying them.
!environments/**/.terraform.lock.hcl

# Crash / debug logs
crash.log
crash.*.log

# Variable files may contain secrets — never commit them,
# but keep the *.tfvars.example templates.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Saved plan output
*.tfplan
tfplan

# CLI config that could hold credentials
.terraformrc
terraform.rc

# Security scanner caches
.tfsec/
.checkov/

# IDE / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
